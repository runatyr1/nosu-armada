# Development embedding target. The signer bridge accepts messages only from
# this exact origin (or, when unset, the origin in document.referrer).
VITE_NOSTRIX_PARENT_ORIGIN=http://localhost:3400

# Production serves the static Armada build beneath the Nostrix origin.
VITE_BASE_PATH=/groups-app/
VITE_PUBLIC_WEB_ORIGIN=https://nostrix.net/groups

# Self-hosted Concord voice brokers can be configured later.
VITE_CONCORD_AV_SERVERS=
